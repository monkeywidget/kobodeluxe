# Copy this to tools/port/ipados.env (gitignored) and fill in your own
# values. tools/port/ipados-install.sh sources it if present.

# Your Apple Developer Team ID (Xcode > Settings > Accounts > your Apple ID
# > team name shows it, or `security find-identity -v -p codesigning`).
# project.pbxproj deliberately leaves DEVELOPMENT_TEAM blank so this stays
# the only place it's recorded; ipados-install.sh passes it to xcodebuild
# as a command-line override.
DEVELOPMENT_TEAM=
